# Use an official Node.js image as the base
FROM node:20

# Set the working directory inside the container
WORKDIR /usr/src/app

# Copy the current project folder to the container
COPY . .

# Install Claude Code globally
RUN npm install -g @anthropic-ai/claude-code

# Expose a port if needed (adjust if Claude Code uses a specific port)
EXPOSE 4000

# Set the default command to launch Claude Code
CMD ["claude"]
